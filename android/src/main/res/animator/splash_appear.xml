<?xml version="1.0" encoding="utf-8"?>
<!-- The mark's tile and waves: nothing but the page for the first 160 ms (Android allows a delayed start of up to
     166 ms), then a 140 ms fade in. A launch that is ready sooner never shows the mark: the splash leaves on the app's
     first frame. Keyframes, not a start delay, so the drawable's own state stays the icon. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="940"
    android:interpolator="@android:interpolator/linear">
    <propertyValuesHolder android:propertyName="fillAlpha" android:valueType="floatType">
        <keyframe android:fraction="0" android:value="0" />
        <keyframe android:fraction="0.1702" android:value="0" />
        <keyframe android:fraction="0.3191" android:interpolator="@android:interpolator/decelerate_quad" android:value="1" />
        <keyframe android:fraction="1" android:value="1" />
    </propertyValuesHolder>
</objectAnimator>
